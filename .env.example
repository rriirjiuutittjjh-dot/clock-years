# Copy to .env for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Public URL of the deployment (required in production so auth cookies/origins work).
# Example: https://clock-years.vercel.app
BETTER_AUTH_URL=

# Long random secret signing the app's own sessions (required in production —
# without it each serverless instance mints its own and logins won't stick).
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Postgres connection string for persistent users/settings (Neon, Supabase…).
# Optional: without it the app runs on the built-in in-memory PGLite fallback
# (data resets on restart — fine for previews, not for real use).
DATABASE_URL=

# Comma-separated emails pinned as owner (optional but recommended in
# production). A listed address is granted owner on sign-in even if it
# registers late or was demoted — the deterministic path to first admin
# where "first account wins" can't be relied on.
# Example: you@example.com
ADMIN_EMAILS=
