# dependencies
node_modules/

# builds & deploy output (regenerated by `npm run build`)
.vercel/
.nitro/
.output/
dist/
build/

# framework caches
.tanstack/

# logs & coverage
*.log
coverage/
playwright-report/
test-results/

# local env (the template injects env at deploy time; never commit secrets)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db

# sandbox runtime state (ephemeral, not source)
.grok/status
